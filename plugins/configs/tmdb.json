{
  "_plugin": "TMDb",
  "_key": "tmdb",
  "_category": "Movies & TV",
  "_description": "The Movie Database — the primary metadata source for movies and TV shows. Provides titles, overviews, posters, backdrops, cast, crew, ratings, and genres. Free API key from https://www.themoviedb.org/settings/api",
  "_docs": "https://developer.themoviedb.org/docs",
  "enabled": true,
  "api_key": "",
  "base_url": "https://api.themoviedb.org/3",
  "language": "en-US",
  "include_adult": true,
  "poster_size": "w500",
  "backdrop_size": "w1280",
  "profile_size": "w185",
  "auto_match": true,
  "nfo_write": true,
  "poster_download": true,
  "backdrop_download": true,
  "cast_metadata": true,
  "crew_metadata": true,
  "genre_sync": true,
  "rating_sync": true,
  "fallback_on_no_match": true,
  "match_threshold": 0.75,
  "append_to_response": "credits,images,keywords,release_dates"
}
